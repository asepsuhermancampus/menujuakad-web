# Neon: pooled untuk runtime; direct untuk migrasi pada branch/database yang sama.
DATABASE_URL=
DIRECT_URL=
NEXT_PUBLIC_APP_URL=
APP_HOSTNAME=
PORT=
AUTH_SECRET=
# Auth core dan provider telah diimplementasikan lokal; belum terhubung/terverifikasi live.
# AUTH_SECRET wajib minimal 32 karakter acak; simpan hanya pada environment server.
# AUTH_TRUST_PROXY kosong = tidak percaya proxy; isi 1 hanya sesudah upstream privat terverifikasi.
AUTH_TRUST_PROXY=
# NEXT_PUBLIC_APP_URL canonical produksi: https://menujuakad.com
# Google redirect harus persis origin canonical + /api/auth/google/callback.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
# Resend: domain pengirim harus diverifikasi; receipt accepted bukan bukti email diterima.
RESEND_API_KEY=
AUTH_EMAIL_FROM=
# Twilio Programmable Messaging (bukan Verify); nomor pengirim wajib E.164.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
MAYAR_API_KEY=
MAYAR_API_BASE_URL=
MAYAR_WEBHOOK_SECRET=
