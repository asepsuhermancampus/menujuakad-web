generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  CUSTOMER
  SUPERADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum InvitationStatus {
  DRAFT
  PENDING_PAYMENT
  ACTIVE
  EXPIRING_SOON
  EXPIRED
  SUSPENDED
  ARCHIVED
}

enum InvitationMemberRole {
  OWNER
  EDITOR
  VIEWER
}

enum TemplateStatus {
  DRAFT
  PUBLISHED
  HIDDEN
  ARCHIVED
}

enum PackageStatus {
  DRAFT
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum InvitationSectionType {
  COVER
  OPENING
  COUPLE
  STORY
  EVENT
  COUNTDOWN
  LOCATION
  GALLERY
  VIDEO
  MUSIC
  RSVP
  WISHES
  GIFT
  DRESS_CODE
  FAQ
  LIVE_STREAM
  HASHTAG
  CONTACT
  ADDITIONAL_INFO
  CLOSING
}

model User {
  id              String     @id @default(cuid())
  email           String     @unique
  emailVerifiedAt DateTime?  @db.Timestamptz(3)
  name            String?
  phone           String?
  avatarUrl       String?
  role            UserRole   @default(CUSTOMER)
  status          UserStatus @default(ACTIVE)
  lastLoginAt     DateTime?  @db.Timestamptz(3)
  createdAt       DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime   @updatedAt @db.Timestamptz(3)

  invitations          Invitation[]
  memberships          InvitationMember[]
  credential           AuthCredential?
  sessions             UserSession[]
  paymentTestRequests  PaymentTestRequest[] @relation("PaymentTestRequester")
  paymentsTestReviewed PaymentTestRequest[] @relation("PaymentTestReviewer")
}

model Template {
  id           String         @id @default(cuid())
  name         String
  slug         String         @unique
  description  String?
  thumbnailUrl String?
  previewUrl   String?
  category     String?
  status       TemplateStatus @default(DRAFT)
  isPremium    Boolean        @default(false)
  usageCount   Int            @default(0)
  createdAt    DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime       @updatedAt @db.Timestamptz(3)

  features    TemplateFeature[]
  invitations Invitation[]
}

model TemplateFeature {
  templateId String
  featureKey String
  template   Template @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@id([templateId, featureKey])
}

model Package {
  id           String        @id @default(cuid())
  name         String
  slug         String        @unique
  description  String?
  price        Int
  currency     String        @default("IDR") @db.VarChar(3)
  durationDays Int
  status       PackageStatus @default(DRAFT)
  isFeatured   Boolean       @default(false)
  sortOrder    Int           @default(0)
  createdAt    DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime      @updatedAt @db.Timestamptz(3)

  features PackageFeature[]
}

model PackageFeature {
  packageId  String
  featureKey String
  package    Package @relation(fields: [packageId], references: [id], onDelete: Cascade)

  @@id([packageId, featureKey])
}

model Invitation {
  id          String           @id @default(cuid())
  ownerUserId String
  templateId  String
  slug        String           @unique @db.VarChar(80)
  title       String
  status      InvitationStatus @default(DRAFT)
  weddingDate DateTime?        @db.Date
  timezone    String           @default("Asia/Jakarta")
  isPublished Boolean          @default(false)
  publishedAt DateTime?        @db.Timestamptz(3)
  startsAt    DateTime?        @db.Timestamptz(3)
  expiresAt   DateTime?        @db.Timestamptz(3)
  createdAt   DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime         @updatedAt @db.Timestamptz(3)

  owner               User                 @relation(fields: [ownerUserId], references: [id], onDelete: Restrict)
  template            Template             @relation(fields: [templateId], references: [id], onDelete: Restrict)
  members             InvitationMember[]
  coupleProfile       CoupleProfile?
  sections            InvitationSection[]
  paymentTestRequests PaymentTestRequest[]

  @@index([ownerUserId, createdAt])
  @@index([status, expiresAt])
}

model InvitationMember {
  id           String               @id @default(cuid())
  invitationId String
  userId       String
  role         InvitationMemberRole @default(VIEWER)
  createdAt    DateTime             @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime             @updatedAt @db.Timestamptz(3)

  invitation Invitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([invitationId, userId])
  @@index([userId])
}

model CoupleProfile {
  id            String   @id @default(cuid())
  invitationId  String   @unique
  groomFullName String?
  groomNickname String?
  groomParents  String?
  groomBio      String?
  groomPhoto    String?
  groomSocial   String?
  brideFullName String?
  brideNickname String?
  brideParents  String?
  brideBio      String?
  bridePhoto    String?
  brideSocial   String?
  createdAt     DateTime @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @db.Timestamptz(3)

  invitation Invitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)
}

model InvitationSection {
  id           String                @id @default(cuid())
  invitationId String
  type         InvitationSectionType
  title        String?
  sortOrder    Int                   @default(0)
  isEnabled    Boolean               @default(true)
  configJson   Json                  @default("{}")
  createdAt    DateTime              @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime              @updatedAt @db.Timestamptz(3)

  invitation Invitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)

  @@index([invitationId, sortOrder])
}

// Credential dan sesi hanya berisi hash; plaintext tidak disimpan pada database.
model AuthCredential {
  userId       String @id
  passwordHash String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UserSession {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime @db.Timestamptz(3)
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model AuthLoginThrottle {
  keyHash        String    @id
  failedAttempts Int
  windowStartsAt DateTime  @db.Timestamptz(3)
  blockedUntil   DateTime? @db.Timestamptz(3)
}

// Pengujian QRIS statis; APPROVED_TEST tidak memberikan entitlement komersial.
enum PaymentTestStatus {
  REQUESTED
  APPROVED_TEST
  REJECTED
}

model PaymentTestRequest {
  id               String            @id @default(cuid())
  invitationId     String
  userId           String
  amountIdr        Int
  packageSlug      String
  status           PaymentTestStatus @default(REQUESTED)
  reference        String?
  createdAt        DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime          @updatedAt @db.Timestamptz(3)
  reviewedAt       DateTime?         @db.Timestamptz(3)
  reviewedByUserId String?

  invitation Invitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)
  user       User       @relation("PaymentTestRequester", fields: [userId], references: [id], onDelete: Restrict)
  reviewedBy User?      @relation("PaymentTestReviewer", fields: [reviewedByUserId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([status, createdAt])
}
