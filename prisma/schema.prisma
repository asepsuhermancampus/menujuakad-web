generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  CLIENT
  SUPERADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum InvitationStatus {
  DRAFT
  PENDING_PAYMENT
  ACTIVE
  EXPIRING_SOON
  EXPIRED
  SUSPENDED
  ARCHIVED
}

enum InvitationMemberRole {
  OWNER
  EDITOR
  VIEWER
}

enum TemplateStatus {
  DRAFT
  PUBLISHED
  HIDDEN
  ARCHIVED
}

enum PackageStatus {
  DRAFT
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum InvitationSectionType {
  COVER
  OPENING
  COUPLE
  STORY
  EVENT
  COUNTDOWN
  LOCATION
  GALLERY
  VIDEO
  MUSIC
  RSVP
  WISHES
  GIFT
  DRESS_CODE
  FAQ
  LIVE_STREAM
  HASHTAG
  CONTACT
  ADDITIONAL_INFO
  CLOSING
}

model User {
  id              String     @id @default(cuid())
  email           String?    @unique
  emailVerifiedAt DateTime?  @db.Timestamptz(3)
  name            String?
  phone           String?    @unique
  phoneVerifiedAt DateTime?  @db.Timestamptz(3)
  smsOtpEnabled   Boolean    @default(false)
  avatarUrl       String?
  role            UserRole   @default(CLIENT)
  status          UserStatus @default(ACTIVE)
  lastLoginAt     DateTime?  @db.Timestamptz(3)
  createdAt       DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime   @updatedAt @db.Timestamptz(3)

  invitations          Invitation[]
  memberships          InvitationMember[]
  credential           AuthCredential?
  sessions             UserSession[]
  authAccounts         AuthAccount[]
  verificationTokens   AuthVerificationToken[]
  paymentTestRequests  PaymentTestRequest[]    @relation("PaymentTestRequester")
  paymentsTestReviewed PaymentTestRequest[]    @relation("PaymentTestReviewer")
  plannerWorkspaces    PlannerWorkspace[]      @relation("PlannerOwner")
  plannerMemberships   PlannerMember[]         @relation("PlannerMemberUser")
  upgradeRequests      UpgradeRequest[]        @relation("UpgradeRequester")
  upgradeReviews       UpgradeRequest[]        @relation("UpgradeReviewer")
  adminAuditLogs       AdminAuditLog[]         @relation("AdminAuditActor")
}

model Template {
  id           String         @id @default(cuid())
  name         String
  slug         String         @unique
  description  String?
  thumbnailUrl String?
  previewUrl   String?
  category     String?
  status       TemplateStatus @default(DRAFT)
  isPremium    Boolean        @default(false)
  usageCount   Int            @default(0)
  createdAt    DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime       @updatedAt @db.Timestamptz(3)

  features    TemplateFeature[]
  invitations Invitation[]
}

model TemplateFeature {
  templateId String
  featureKey String
  template   Template @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@id([templateId, featureKey])
}

model Package {
  id           String        @id @default(cuid())
  name         String
  slug         String        @unique
  description  String?
  price        Int
  currency     String        @default("IDR") @db.VarChar(3)
  durationDays Int
  status       PackageStatus @default(DRAFT)
  isFeatured   Boolean       @default(false)
  sortOrder    Int           @default(0)
  createdAt    DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime      @updatedAt @db.Timestamptz(3)

  features PackageFeature[]
}

model PackageFeature {
  packageId  String
  featureKey String
  package    Package @relation(fields: [packageId], references: [id], onDelete: Cascade)

  @@id([packageId, featureKey])
}

model Invitation {
  id          String           @id @default(cuid())
  ownerUserId String
  templateId  String
  slug        String           @unique @db.VarChar(80)
  title       String
  status      InvitationStatus @default(DRAFT)
  weddingDate DateTime?        @db.Date
  timezone    String           @default("Asia/Jakarta")
  isPublished Boolean          @default(false)
  publishedAt DateTime?        @db.Timestamptz(3)
  startsAt    DateTime?        @db.Timestamptz(3)
  expiresAt   DateTime?        @db.Timestamptz(3)
  createdAt   DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime         @updatedAt @db.Timestamptz(3)

  owner               User                 @relation(fields: [ownerUserId], references: [id], onDelete: Restrict)
  template            Template             @relation(fields: [templateId], references: [id], onDelete: Restrict)
  members             InvitationMember[]
  coupleProfile       CoupleProfile?
  sections            InvitationSection[]
  paymentTestRequests PaymentTestRequest[]

  @@index([ownerUserId, createdAt])
  @@index([status, expiresAt])
}

model InvitationMember {
  id           String               @id @default(cuid())
  invitationId String
  userId       String
  role         InvitationMemberRole @default(VIEWER)
  createdAt    DateTime             @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime             @updatedAt @db.Timestamptz(3)

  invitation Invitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([invitationId, userId])
  @@index([userId])
}

model CoupleProfile {
  id            String   @id @default(cuid())
  invitationId  String   @unique
  groomFullName String?
  groomNickname String?
  groomParents  String?
  groomBio      String?
  groomPhoto    String?
  groomSocial   String?
  brideFullName String?
  brideNickname String?
  brideParents  String?
  brideBio      String?
  bridePhoto    String?
  brideSocial   String?
  createdAt     DateTime @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @db.Timestamptz(3)

  invitation Invitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)
}

model InvitationSection {
  id           String                @id @default(cuid())
  invitationId String
  type         InvitationSectionType
  title        String?
  sortOrder    Int                   @default(0)
  isEnabled    Boolean               @default(true)
  configJson   Json                  @default("{}")
  createdAt    DateTime              @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime              @updatedAt @db.Timestamptz(3)

  invitation Invitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)

  @@index([invitationId, sortOrder])
}

// Credential dan sesi hanya berisi hash; plaintext tidak disimpan pada database.
model AuthCredential {
  userId       String @id
  passwordHash String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UserSession {
  id                String    @id @default(cuid())
  userId            String
  tokenHash         String    @unique
  expiresAt         DateTime  @db.Timestamptz(3)
  createdAt         DateTime  @default(now()) @db.Timestamptz(3)
  reauthenticatedAt DateTime? @db.Timestamptz(3)
  lastSeenAt        DateTime? @db.Timestamptz(3)
  revokedAt         DateTime? @db.Timestamptz(3)
  userAgent         String?   @db.VarChar(512)
  ipHash            String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model AuthLoginThrottle {
  keyHash        String    @id
  failedAttempts Int
  windowStartsAt DateTime  @db.Timestamptz(3)
  blockedUntil   DateTime? @db.Timestamptz(3)
}

// Pengujian QRIS statis; APPROVED_TEST tidak memberikan entitlement komersial.
enum PaymentTestStatus {
  REQUESTED
  APPROVED_TEST
  REJECTED
}

model PaymentTestRequest {
  id               String            @id @default(cuid())
  invitationId     String
  userId           String
  amountIdr        Int
  packageSlug      String
  status           PaymentTestStatus @default(REQUESTED)
  reference        String?
  createdAt        DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime          @updatedAt @db.Timestamptz(3)
  reviewedAt       DateTime?         @db.Timestamptz(3)
  reviewedByUserId String?

  invitation Invitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)
  user       User       @relation("PaymentTestRequester", fields: [userId], references: [id], onDelete: Restrict)
  reviewedBy User?      @relation("PaymentTestReviewer", fields: [reviewedByUserId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([status, createdAt])
}

// Identitas provider ditautkan hanya setelah verifikasi server.
model AuthAccount {
  id                String   @id @default(cuid())
  userId            String
  provider          String
  providerAccountId String
  email             String?
  emailVerified     Boolean  @default(false)
  createdAt         DateTime @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime @updatedAt @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@unique([userId, provider])
}

// Token/OTP di-hash; payload rahasia harus dienkripsi oleh layanan.
model AuthVerificationToken {
  id         String    @id @default(cuid())
  tokenHash  String    @unique
  purpose    String
  userId     String?
  identifier String?
  payload    Json?
  expiresAt  DateTime  @db.Timestamptz(3)
  consumedAt DateTime? @db.Timestamptz(3)
  attempts   Int       @default(0)
  createdAt  DateTime  @default(now()) @db.Timestamptz(3)

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
  @@index([identifier, purpose])
  @@index([expiresAt])
}

// ---------------------------------------------------------------------------
// Domain perencanaan pernikahan (benchmark Meet to Marry, increment 10 Oktober 2026).
// Semua nominal uang integer IDR. Model ditambahkan bertahap saat domainnya
// dikerjakan; belum ada UI yang menulis ke model ini sampai backend aktif.
// ---------------------------------------------------------------------------

enum EventContext {
  WEDDING
  ENGAGEMENT
}

enum PlannerMemberRole {
  OWNER
  PARTNER
}

enum PlannerInviteStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
}

enum SavingsOwner {
  SELF
  PARTNER
  SHARED
}

enum PlannerTaskStatus {
  PENDING
  DONE
}

enum PlannerTaskPic {
  SELF
  PARTNER
  SHARED
}

enum VendorPaymentStatus {
  UNPAID
  PARTIAL
  PAID
}

enum SeserahanCategory {
  SESERAHAN_WANITA
  SESERAHAN_PRIA
  HANTARAN_LAMARAN
}

enum SeserahanStatus {
  NOT_BOUGHT
  BOUGHT
  PREPARED
}

enum MoodboardCategory {
  DEKORASI
  BUSANA
  UNDANGAN
  KUE
  FOTOGRAFI
}

enum WeddingKitFormat {
  SPREADSHEET
  MOODBOARD
  CHECKLIST
}

enum WeddingKitOrderStatus {
  PENDING_PAYMENT
  PAID
  FULFILLED
  CANCELLED
}

enum UpgradeRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ContentSectionKey {
  BRAND
  LANDING
  PRICING
  FAQ
  ANNOUNCEMENT
}

enum AdminAuditResult {
  SUCCESS
  FAILED
}

/// Workspace perencanaan pasangan; pemilik seluruh data perencanaan.
/// Undangan tetap dimiliki `Invitation`; workspace tidak menggantikan owner.
model PlannerWorkspace {
  id                String    @id @default(cuid())
  ownerUserId       String
  partnerName       String?
  weddingDate       DateTime? @db.Date
  timezone          String    @default("Asia/Jakarta")
  savingsTargetIdr  Int?
  savingsTargetDate DateTime? @db.Date
  onboardingDoneAt  DateTime? @db.Timestamptz(3)
  createdAt         DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime  @updatedAt @db.Timestamptz(3)

  owner        User                   @relation("PlannerOwner", fields: [ownerUserId], references: [id], onDelete: Restrict)
  members      PlannerMember[]
  invites      PlannerInvite[]
  accounts     SavingsAccount[]
  categories   BudgetCategory[]
  expenses     Expense[]
  tasks        PlannerTask[]
  rundowns     RundownItem[]
  vendors      Vendor[]
  seserahan    SeserahanItem[]
  requirements RequirementItem[]
  engagement   EngagementPlan?
  moodboards   MoodboardBoard[]
  kitOrders    WeddingKitOrder[]

  @@index([ownerUserId])
}

model PlannerMember {
  id          String            @id @default(cuid())
  workspaceId String
  userId      String
  role        PlannerMemberRole @default(PARTNER)
  createdAt   DateTime          @default(now()) @db.Timestamptz(3)

  workspace PlannerWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User             @relation("PlannerMemberUser", fields: [userId], references: [id], onDelete: Restrict)

  @@unique([workspaceId, userId])
  @@index([userId])
}

/// Undangan pasangan; token di-hash, maksimal satu undangan aktif per workspace.
model PlannerInvite {
  id          String              @id @default(cuid())
  workspaceId String
  tokenHash   String              @unique
  invitedLabel String
  status      PlannerInviteStatus @default(PENDING)
  expiresAt   DateTime            @db.Timestamptz(3)
  acceptedAt  DateTime?           @db.Timestamptz(3)
  createdAt   DateTime            @default(now()) @db.Timestamptz(3)

  workspace PlannerWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, status])
}

model SavingsAccount {
  id           String       @id @default(cuid())
  workspaceId  String
  label        String
  bank         String
  owner        SavingsOwner @default(SHARED)
  accountNumber String?
  balanceIdr   Int          @default(0)
  notes        String?
  sortOrder    Int          @default(0)
  createdAt    DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime     @updatedAt @db.Timestamptz(3)

  workspace  PlannerWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  transfersFrom SavingsTransfer[] @relation("SavingsFrom")
  transfersTo   SavingsTransfer[] @relation("SavingsTo")
  expenses   Expense[]

  @@index([workspaceId, sortOrder])
}

/// Transfer antar rekening; dicatat sebagai pasangan debit/kredit.
model SavingsTransfer {
  id            String   @id @default(cuid())
  workspaceId   String
  fromAccountId String
  toAccountId   String
  amountIdr     Int
  note          String?
  transferredAt DateTime @db.Date
  createdAt     DateTime @default(now()) @db.Timestamptz(3)

  fromAccount SavingsAccount @relation("SavingsFrom", fields: [fromAccountId], references: [id], onDelete: Restrict)
  toAccount   SavingsAccount @relation("SavingsTo", fields: [toAccountId], references: [id], onDelete: Restrict)

  @@index([workspaceId, transferredAt])
}

model BudgetCategory {
  id           String       @id @default(cuid())
  workspaceId  String
  name         String
  budgetIdr    Int          @default(0)
  eventContext EventContext @default(WEDDING)
  sortOrder    Int          @default(0)
  createdAt    DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime     @updatedAt @db.Timestamptz(3)

  workspace PlannerWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  expenses  Expense[]

  @@index([workspaceId, eventContext, sortOrder])
}

model Expense {
  id           String       @id @default(cuid())
  workspaceId  String
  categoryId   String?
  accountId    String?
  description  String
  amountIdr    Int
  spentAt      DateTime     @db.Date
  eventContext EventContext @default(WEDDING)
  note         String?
  createdAt    DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime     @updatedAt @db.Timestamptz(3)

  workspace PlannerWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  category  BudgetCategory?  @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  account   SavingsAccount?  @relation(fields: [accountId], references: [id], onDelete: SetNull)

  @@index([workspaceId, spentAt])
  @@index([workspaceId, categoryId])
}

model PlannerTask {
  id           String            @id @default(cuid())
  workspaceId  String
  title        String
  description  String?
  pic          PlannerTaskPic    @default(SHARED)
  dueDate      DateTime?         @db.Date
  status       PlannerTaskStatus @default(PENDING)
  eventContext EventContext      @default(WEDDING)
  sortOrder    Int               @default(0)
  createdAt    DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime          @updatedAt @db.Timestamptz(3)

  workspace PlannerWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, status, dueDate])
}

model RundownItem {
  id           String         @id @default(cuid())
  workspaceId  String
  startTime    String         @db.VarChar(5)
  endTime      String?        @db.VarChar(5)
  title        String
  description  String?
  pic          PlannerTaskPic @default(SHARED)
  eventContext EventContext   @default(WEDDING)
  sortOrder    Int            @default(0)
  createdAt    DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime       @updatedAt @db.Timestamptz(3)

  workspace PlannerWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, eventContext, sortOrder])
}

model Vendor {
  id           String              @id @default(cuid())
  workspaceId  String
  name         String
  category     String?
  contact      String?
  totalIdr     Int                 @default(0)
  paidIdr      Int                 @default(0)
  status       VendorPaymentStatus @default(UNPAID)
  eventContext EventContext        @default(WEDDING)
  note         String?
  createdAt    DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime            @updatedAt @db.Timestamptz(3)

  workspace PlannerWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, status])
}

model SeserahanItem {
  id          String            @id @default(cuid())
  workspaceId String
  name        String
  category    SeserahanCategory
  estimateIdr Int               @default(0)
  status      SeserahanStatus   @default(NOT_BOUGHT)
  purchaseUrl String?
  note        String?
  sortOrder   Int               @default(0)
  createdAt   DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime          @updatedAt @db.Timestamptz(3)

  workspace PlannerWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, category, sortOrder])
}

model RequirementItem {
  id           String    @id @default(cuid())
  workspaceId  String
  name         String
  done         Boolean   @default(false)
  dueDate      DateTime? @db.Date
  note         String?
  attachmentKey String?
  sortOrder    Int       @default(0)
  createdAt    DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime  @updatedAt @db.Timestamptz(3)

  workspace PlannerWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, done, sortOrder])
}

model EngagementPlan {
  id          String   @id @default(cuid())
  workspaceId String   @unique
  active      Boolean  @default(false)
  eventName   String?
  eventDate   DateTime? @db.Date
  budgetIdr   Int      @default(0)
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  workspace PlannerWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

model MoodboardBoard {
  id          String   @id @default(cuid())
  workspaceId String
  name        String
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  workspace PlannerWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  items     MoodboardItem[]

  @@index([workspaceId, sortOrder])
}

model MoodboardItem {
  id        String            @id @default(cuid())
  boardId   String
  title     String
  category  MoodboardCategory
  imageRef  String?
  sourceUrl String?
  sortOrder Int               @default(0)
  createdAt DateTime          @default(now()) @db.Timestamptz(3)

  board MoodboardBoard @relation(fields: [boardId], references: [id], onDelete: Cascade)

  @@index([boardId, sortOrder])
}

model WeddingKitProduct {
  id        String          @id @default(cuid())
  slug      String          @unique
  name      String
  summary   String?
  priceIdr  Int
  format    WeddingKitFormat
  contents  Json            @default("[]")
  status    TemplateStatus  @default(DRAFT)
  sortOrder Int             @default(0)
  createdAt DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt DateTime        @updatedAt @db.Timestamptz(3)

  orders WeddingKitOrder[]
}

model WeddingKitOrder {
  id          String               @id @default(cuid())
  workspaceId String
  productId   String
  status      WeddingKitOrderStatus @default(PENDING_PAYMENT)
  amountIdr   Int
  reference   String?
  createdAt   DateTime             @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime             @updatedAt @db.Timestamptz(3)

  workspace PlannerWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  product   WeddingKitProduct @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([workspaceId, createdAt])
}

/// Permintaan upgrade paket; keputusan admin dicatat, email terpisah.
model UpgradeRequest {
  id              String               @id @default(cuid())
  userId          String
  fromPackageSlug String?
  toPackageSlug   String
  status          UpgradeRequestStatus @default(PENDING)
  proofKey        String?
  decidedAt       DateTime?            @db.Timestamptz(3)
  decidedByUserId String?
  decisionNote    String?
  createdAt       DateTime             @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime             @updatedAt @db.Timestamptz(3)

  user      User  @relation("UpgradeRequester", fields: [userId], references: [id], onDelete: Restrict)
  decidedBy User? @relation("UpgradeReviewer", fields: [decidedByUserId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
}

/// Konten publik yang dapat diedit admin tanpa deploy; publikasi eksplisit.
model ContentSection {
  id          String           @id @default(cuid())
  key         ContentSectionKey @unique
  draftJson   Json             @default("{}")
  publishedJson Json?          @default("{}")
  draftSavedAt DateTime?       @db.Timestamptz(3)
  publishedAt DateTime?        @db.Timestamptz(3)
  createdAt   DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime         @updatedAt @db.Timestamptz(3)
}

/// Pengaturan pembayaran manual (QRIS statis + rekening); bukan integrasi provider.
model PaymentSetting {
  id              String   @id @default(cuid())
  qrisKey         String?
  qrisLabel       String?
  accountsJson    Json     @default("[]")
  adminWhatsapp   String?
  messageTemplate String?
  createdAt       DateTime @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @db.Timestamptz(3)
}

/// Audit aksi admin; tidak boleh dihapus dari UI.
model AdminAuditLog {
  id         String           @id @default(cuid())
  actorUserId String
  action     String
  targetType String
  targetId   String?
  reason     String?
  result     AdminAuditResult @default(SUCCESS)
  createdAt  DateTime         @default(now()) @db.Timestamptz(3)

  actor User @relation("AdminAuditActor", fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([createdAt])
  @@index([actorUserId, createdAt])
}
