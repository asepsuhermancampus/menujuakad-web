{
  "name": "menuju-akad",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0 <23 || >=24.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build && node scripts/prepare-standalone.mjs",
    "start": "node scripts/start.mjs",
    "typecheck": "prisma generate && tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:export:neon": "tsx scripts/database/export-neon.ts",
    "db:preflight:neon": "tsx scripts/database/neon-preflight.ts",
    "check": "npm run db:validate && npm run typecheck && npm run lint && npm test && npm run build"
  },
  "dependencies": {
    "@prisma/adapter-neon": "7.10.0",
    "@prisma/client": "7.10.0",
    "clsx": "^2.1.1",
    "dotenv": "^17.2.3",
    "next": "16.3.8",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.4.3",
    "@playwright/test": "^1.56.0",
    "@types/node": "^22.18.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "^9.39.0",
    "eslint-config-next": "16.3.8",
    "prettier": "^3.6.2",
    "prisma": "7.10.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "5.0.3"
  }
}
