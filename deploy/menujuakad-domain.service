[Unit]
Description=Aktivasi HTTPS Menuju Akad setelah DNS authoritative siap
After=network-online.target caddy.service
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/srv/menujuakad/deploy/finalize-domain.sh
TimeoutStartSec=90
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
